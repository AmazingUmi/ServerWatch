# 首次使用：cp -n scripts/new_node.env.example scripts/new_node.env
# 编辑真实配置后执行：bash scripts/deploy-serverwatch.sh --dry-run
# 格式与 JobFlow 一致：KEY=value，支持空行和整行注释。
# 值直接填写，不加引号；不展开 $HOME 或 shell 命令。
# SSH_KEY 的路径可使用本机 ~/；远端路径留空使用默认值，不写 ~。

# SSH 目标：使用 NODE_IP + ROOT_USER，或使用 ROOT_SSH，二者选一。
# NODE_IP 可填写 IPv4、主机名或 SSH 别名。请替换此示例地址。
NODE_IP=192.0.2.10
ROOT_USER=root

# 使用 SSH 别名或 user@hostname 时填写此项，同时清空上面两项。
ROOT_SSH=
# 留空沿用 SSH 配置中的 Port；填写 22 会显式覆盖别名的端口。
SSH_PORT=22

# 可选：用于登录现有账号的私钥，不是 JobFlow 的 KEY 公钥配置。
# 支持绝对路径、本机 ~/ 或相对于本 env 文件的路径；留空沿用 SSH 配置/agent。
# 脚本不会上传私钥，也不会修改服务器 authorized_keys。
SSH_KEY=

# 远端安装前缀；留空使用登录账号的 ~/.local。
# 程序安装到 INSTALL_PREFIX/bin/serverwatch。
INSTALL_PREFIX=

# 后台状态文件的绝对路径；留空使用 /run/user/UID/serverwatch/status.json。
STATE_FILE=

# true：安装并启用 serverwatch.service 用户服务。
# false：只安装 CLI，不启用服务，也不修改 linger。
ENABLE_SERVICE=true

# true：为运行账号启用 linger，使服务在登出后和开机时继续运行。
# 需要 root，或运行账号能免交互 sudo。ENABLE_SERVICE=false 时不生效。
ENABLE_LINGER=true

# 后台采集参数。修改后以 --upgrade 部署并重启采集器。
INTERVAL=2
WINDOW=60
TOP=5
GPU=auto
GPU_INTERVAL=5
